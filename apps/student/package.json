{
  "name": "sutaniese",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-optional-natives.cjs",
    "cap:sync": "node ../../node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:open:android": "node ../../node_modules/@capacitor/cli/bin/capacitor open android",
    "android:assemble-debug": "node scripts/android-assemble-debug.cjs",
    "android:apk-desktop": "node scripts/copy-debug-apk-to-desktop.cjs",
    "android:build-apk-desktop": "npm run cap:sync && npm run android:assemble-debug && npm run android:apk-desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@pathwise/shared": "*",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "next": "15.5.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "node-mocks-http": "^1.17.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.4",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
