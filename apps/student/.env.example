# Optional: absolute URL of an external portal. Leave empty for the built-in `/hub` routes.
# NEXT_PUBLIC_PORTAL_URL=
#
# Optional: absolute URL of an external student app. Leave empty for same-origin links.
# NEXT_PUBLIC_STUDENT_URL=
#
# --- Supabase (production path for shared teacher+student class) ---
# Apply supabase/migrations/20260902160224_shared_class_persistence.sql to the project.
# Auth → turn off "Confirm email" for the live demo, or signup has no session.
NEXT_PUBLIC_SUPABASE_URL=
# Current docs name; NEXT_PUBLIC_SUPABASE_ANON_KEY still works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by grants live query. NEVER put this in client code.
# SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=   # alias of NEXT_PUBLIC_SUPABASE_URL for grants
#
# Demo fixtures (6 fake students / vault seed). Leave unset in production.
# NEXT_PUBLIC_DEMO_ROSTER=1
# DEMO_VAULT_SEED=1
#
# Optional: Gemini key for `/hub` recommendation letters.
# GEMINI_API_KEY=
#
# Optional — if set, POST /api/generate tries one Groq chat completion first, then
# always falls back to the built-in deterministic engine when the call fails
# or when this key is unset.
# On Vercel: add the same name in Project → Settings → Environment Variables
# for Production (and Preview if needed), then redeploy. .env.local is not deployed.
GROQ_API_KEY=
#
# Android APK (Capacitor): unused for the live demo (iOS Safari Add to Home Screen).
# CAPACITOR_SERVER_URL=https://your-project.vercel.app
# Optional model (default: openai/gpt-oss-120b). Old llama-3.3-70b-versatile was retired Aug 2026.
# GROQ_MODEL=openai/gpt-oss-120b
# Optional — voice transcription (/api/voice-transcribe); default whisper-large-v3-turbo
# GROQ_AUDIO_MODEL=
