# Optional: absolute URL of an external portal. Leave empty for the built-in `/hub` routes.
# NEXT_PUBLIC_PORTAL_URL=
#
# Optional: absolute URL of an external student app. Leave empty for same-origin links.
# NEXT_PUBLIC_STUDENT_URL=
#
# Optional: Gemini key for `/hub` AI mentor and comparison APIs.
# GEMINI_API_KEY=
#
# Optional — if set, POST /api/generate tries one Groq chat completion first, then
# always falls back to the built-in deterministic engine when the call fails
# or when this key is unset.
GROQ_API_KEY=
# Optional model (Groq; default in code: llama-3.3-70b-versatile)
# GROQ_MODEL=
