{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@pathwise/shared": ["../../packages/shared/src/index.ts"],
      "@pathwise/shared/links": ["../../packages/shared/src/links.ts"],
      "@pathwise/shared/brand": ["../../packages/shared/src/brand.ts"],
      "@pathwise/shared/generate": ["../../packages/shared/src/generate-contract.ts"],
      "@pathwise/shared/universities": ["../../packages/shared/src/universities.ts"],
      "@pathwise/shared/grants": ["../../packages/shared/src/grants.ts"]
    }
  },
  "include": ["src", "../../packages/shared/src"]
}
