{
  "expo": {
    "name": "teñ.",
    "slug": "ten-learning",
    "scheme": "ten",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "info.nurakhmet.ten",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "teñ. uses the microphone for the voice mentor and voice control."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFF"
      },
      "package": "info.nurakhmet.ten",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "teñ. uses the microphone for the voice mentor."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "teñ. attaches photos to your portfolio on this device.",
          "cameraPermission": false
        }
      ],
      "expo-document-picker",
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
